name: Build and push backend to ECR

# 1. The trigger
on:
  push:
    branches: [ "main" ]
    
# 2. Security permissions
permissions:
  id-token: write
  contents: read

# 3. The schematics
jobs:
  build-and-push:
    runs-on: ubuntu-latest

    steps:
      # Step A: Download your source code (FIXED: Added the missing action)
      - name: Checkout Code
        uses: actions/checkout@v4

      # Step B: Securely log into AWS
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.BACKEND_GITHUB_ROLE_ARN }}
          aws-region: eu-west-2

      # Step C: Log into your private ECR Vault
      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      # Step D: Build the image and push to the Vault
      - name: Build, tag, and push Docker image
        env:
          # FIXED: Changed REGISTRATION to REGISTRY
          REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          REPOSITORY: rr-dev-backend
          IMAGE_TAG: latest
        run: |
          docker build -t $REGISTRY/$REPOSITORY:$IMAGE_TAG -t $REGISTRY/$REPOSITORY:${{ github.sha }} .
          docker push -a $REGISTRY/$REPOSITORY